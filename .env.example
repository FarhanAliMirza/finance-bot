# Copy to .env for local runs. Never commit real secrets.

# Production: token for the live bot users already talk to.
# Feature testing: create a separate bot via @BotFather (e.g. FinanceBot Dev)
# and put that token here so you never restart the production process from a feature branch.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Google Gemini API key (used as GEMINI_API_KEY in code)
GEMINI_API_KEY=your_gemini_api_key

# App database connection (Prisma client)
# Prefer a separate database when testing features so you do not mutate live expense data.
DATABASE_URL=postgresql://user:password@host:5432/finance_bot

# Prisma CLI / migrations (often the same as DATABASE_URL, or a direct URL if using a pooler)
DIRECT_URL=postgresql://user:password@host:5432/finance_bot
