generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  Cash
  Card
  UPI
}

model Expense {
  id            String         @id @default(uuid())
  userId        String
  amount        Float
  category      String
  description   String
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())
}

model UserBudget{
  id          String   @id @default(uuid())
  userId      String   @unique
  monthlyBudget Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OnboardingStep {
  WELCOME
  EXPENSE_INTRO
  SET_BUDGET
  COMPLETED
}

model UserOnboarding {
  id          String         @id @default(uuid())
  userId      String         @unique
  step        OnboardingStep @default(WELCOME)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}